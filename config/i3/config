# Start i3bar to display a workspace bar
# (plus the system information i3status finds out, if available)

# EndeavourOS-style notifications
exec --no-startup-id dunst

# Rofi application launcher
exec --no-startup-id ~/.fehbg

exec --no-startup-id ~/.screenlayout/monitors.sh


# BEGIN AEROSPACE SHORTCUTS

# Focus windows
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Resize windows
bindsym $mod+minus resize shrink width 50 px or 5 ppt
bindsym $mod+equal resize grow width 50 px or 5 ppt

# Layouts
bindsym $mod+slash split toggle
bindsym $mod+comma layout stacking

# Workspaces

# Previous workspace

# Move current workspace to next monitor

# END AEROSPACE SHORTCUTS


# BEGIN MULTI-MONITOR SHORTCUTS

# Focus another monitor
bindsym $mod+Ctrl+h focus output left
bindsym $mod+Ctrl+j focus output down
bindsym $mod+Ctrl+k focus output up
bindsym $mod+Ctrl+l focus output right

# Move focused window to another monitor
bindsym $mod+Ctrl+Shift+h move container to output left
bindsym $mod+Ctrl+Shift+j move container to output down
bindsym $mod+Ctrl+Shift+k move container to output up
bindsym $mod+Ctrl+Shift+l move container to output right

# Move entire workspace to another monitor

# END MULTI-MONITOR SHORTCUTS

focus_follows_mouse no

font pango:Noto Sans 10

bindsym Mod4+l exec --no-startup-id ~/.config/i3/scripts/lock.sh

exec --no-startup-id ~/.config/i3/scripts/mouse-settings.sh

exec --no-startup-id xrdb -merge ~/.Xresources

# Rofi on bottom-left monitor
bindsym $mod+d exec --no-startup-id rofi -show drun -monitor DP-2

# Screenshot selection

# Screenshot with Super + Shift + S
bindsym Mod4+Shift+s exec --no-startup-id flameshot gui

# Hide window
bindsym Mod4+h move scratchpad

# Show hidden window
bindsym Mod4+Shift+h exec --no-startup-id python3 ~/.config/polybar/scratchpad.py menu
# Polybar status bar
exec_always --no-startup-id ~/.config/polybar/launch.sh

# Keyboard language switching
exec --no-startup-id setxkbmap -layout "us,ge" -option "grp:win_space_toggle"

# One workspace per monitor
workspace 1 output HDMI-1-0
workspace 2 output DVI-D-1-0
workspace 3 output DP-2
workspace 4 output HDMI-3
